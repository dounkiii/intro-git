# === X (Twitter) API ===
# https://developer.twitter.com/ でアプリを作成し Bearer Token を取得
X_BEARER_TOKEN=

# === TikTok Content Posting API ===
# https://developers.tiktok.com/ でアプリ申請・審査後にトークンを取得
TIKTOK_ACCESS_TOKEN=

# === Threads API (Meta Graph API) ===
# https://developers.facebook.com/docs/threads/ でアプリ登録・権限取得後に発行
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# === Optional: LLM でスクリプト要約 ===
OPENAI_API_KEY=

# === 安全設定 ===
# true の間は実際の投稿を行わずファイル出力のみ（既定: true）
DRY_RUN=true
# true の間は人間の承認なしに投稿しない（既定: true）
REVIEW_REQUIRED=true
