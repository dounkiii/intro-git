# === 原稿生成 (Claude) ===
# https://console.anthropic.com/ で取得。これだけ設定すれば動く。
# 未設定でもパイプラインは止まらないが、テンプレ生成になり文章品質は上がらない。
ANTHROPIC_API_KEY=

# === アフィリエイト（収益の主軸。閾値ゼロで換金できる唯一の経路） ===
# リンクは config.yaml に書かず、ここ / GitHub Secrets から注入する。
# 空のスロットを指す案件は自動的にスキップされる。
AFF_HUB_URL=            # プロフィールに置くリンク集約ページ
AFF_PRODUCT_URL=        # 自前デジタル商品 (note / Tips / BASE)
AFF_ACCOUNTING_SOFT=    # 会計 / 確定申告ソフト
AFF_TAX_ADVISOR=        # 税理士紹介
AFF_FURUSATO=           # ふるさと納税サイト
AFF_SECURITIES=         # 証券口座
AFF_INSURANCE=          # 保険相談

# === X (Twitter) API ===
# 未設定なら data/sample_tweets.json で動作する
X_BEARER_TOKEN=

# === TikTok Content Posting API ===
# https://developers.tiktok.com/ でアプリ申請・審査後にトークンを取得
# 未審査アプリは privacy_level=SELF_ONLY（本人のみ）しか投稿できない
TIKTOK_ACCESS_TOKEN=

# === GitHub（承認 Issue の作成・更新） ===
# GitHub Actions 内では自動で入るのでローカル検証時のみ設定する
GITHUB_TOKEN=
GITHUB_REPOSITORY=      # 例: yourname/your-repo

# === 安全設定 ===
# true の間は実際の投稿を行わずファイル出力のみ（既定: true）
DRY_RUN=true
# true の間は人間の承認なしに投稿しない（既定: true）
REVIEW_REQUIRED=true
